# Copier vers ~/.config/facturation-pro/config.env (chmod 600). Ne jamais committer.
# Clés : https://www.facturation.pro/account/api (avatar en haut à droite > Clé API)
FACTURATION_API_ID=identifiant_api
FACTURATION_API_KEY=cle_api
# ID de l'entreprise à piloter : `python3 scripts/fp.py account` les liste toutes
FACTURATION_FIRM_ID=123456
# Demandé par l'éditeur : nom d'appli + contact, sans accents
FACTURATION_USER_AGENT=ClaudeCode facturation-pro (contact@exemple.fr)
